{
  "name": "smsservice",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "consumers:start-sms:dev": "NODE_ENV=test nodemon consumers/scripts/sms-consumers.js",
    "consumers:start-email:dev": "NODE_ENV=test nodemon consumers/scripts/email-consumers.js",
    "consumers:start-whatsapp:dev": "NODE_ENV=test nodemon consumers/scripts/whatsapp-consumers.js",
    "consumers:start-sms:production": "NODE_ENV=production nodemon consumers/scripts/sms-consumers.js --name=sms",
    "consumers:start-email:production": "NODE_ENV=production nodemon consumers/scripts/email-consumers.js --name=email",
    "consumers:start-whatsapp:production": "NODE_ENV=production nodemon consumers/scripts/whatsapp-consumers.js --name=whatsapp",
    "consumers:start-all:production": "NODE_ENV=production npx pm2 start consumers/scripts/sms-consumers.js --name=sms && npx pm2 start consumers/scripts/email-consumers.js --name=email && npx pm2 start consumers/scripts/whatsapp-consumers.js --name=whatsapp  ",
    "webhook:start:dev": "NODE_ENV=test node webhook/bin/www",
    "webhook:start:production": "NODE_ENV=production npx pm2 start webhook/bin/www"
  },
  "author": "Denis Ogutu",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@sendgrid/mail": "^8.1.3",
    "amqplib": "^0.10.4",
    "axios": "^1.7.2",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "http-errors": "~1.6.3",
    "moment-timezone": "^0.5.45",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.3",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "pg": "^8.16.0"
  }
}
